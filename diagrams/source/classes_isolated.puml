' One diagram per class. Each @startuml block produces its own image,
' named after the block (Utilisateur.png, Client.png, ...).
' Keep style.iuml in the same folder.

@startuml Utilisateur
!include style.iuml
title Classe Utilisateur
abstract class Utilisateur {
  - id : int
  - nom : String
  - prenom : String
  - email : String
  - telephone : String
  - motDePasse : String
  - statut : StatutCompte
  + sAuthentifier() : boolean
  + verifierCode(code : String) : boolean
  + renvoyerCode() : void
}
class Client
class Coach
class Receptionniste
class Administrateur
class CodeVerification
class Notification
Utilisateur <|-- Client
Utilisateur <|-- Coach
Utilisateur <|-- Receptionniste
Utilisateur <|-- Administrateur
Utilisateur "1" -- "0..*" CodeVerification : reçoit
Utilisateur "1" -- "0..*" Notification : reçoit
@enduml

@startuml Client
!include style.iuml
title Classe Client
class Client {
  + creerCompte() : void
  + consulterInstallations() : List<Installation>
  + reserverCreneau(c : Creneau) : Reservation
  + modifierReservation(r : Reservation) : void
  + annulerReservation(r : Reservation) : void
  + sInscrire(a : Activite) : Inscription
  + annulerInscription(i : Inscription) : void
  + souscrireAbonnement(t : Tarif) : Abonnement
  + renouvelerAbonnement(a : Abonnement) : void
  + payerEnLigne(p : Paiement) : void
}
class Utilisateur
class Reservation
class Inscription
class Abonnement
Utilisateur <|-- Client
Client "1" -- "0..*" Reservation : effectue
Client "1" -- "0..*" Inscription : réalise
Client "1" -- "0..*" Abonnement : souscrit
@enduml

